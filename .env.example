# ====================================================
# ProjectX-Ray AI - Production Environment Configuration
# ====================================================

# Environment & Server
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Deterministic Mock Mode
# Set to 'true' for local testing and deterministic demonstrations.
# Set to 'false' for live production provider routing.
MOCK_AI=true

# Database Persistence
# High-performance zero-dependency SQLite path (Node 22 native DatabaseSync in WAL mode)
DATABASE_PATH=projectxray.db

# Storage Configuration
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_MAX_FILE_SIZE_MB=500
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Authentication & Access Control
JWT_SECRET=super_secret_production_key_change_in_prod
SESSION_EXPIRY_HOURS=24

# AI Provider Routing Configuration
LLM_PROVIDER=gemini
VISION_PROVIDER=gemini
TRANSCRIPTION_PROVIDER=whisper
SEARCH_PROVIDER=semantic_scholar
EMBEDDING_PROVIDER=openai

# AI Provider Credentials (Required when MOCK_AI=false)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# Research Intelligence Providers
SEMANTIC_SCHOLAR_API_KEY=
USPTO_API_KEY=
PERPLEXITY_API_KEY=
TAVILY_API_KEY=
GITHUB_TOKEN=

# Production Rate Limits
RATE_LIMIT_PROJECT_CREATION=20
RATE_LIMIT_EVALUATIONS_HOURLY=10
RATE_LIMIT_UPLOADS_PER_MIN=30
RATE_LIMIT_REPORT_EXPORT=50
