{
  "name": "final-year-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "tsx backend/src/server.ts",
    "dev:all": "node scripts/dev.js",
    "db:seed": "tsx backend/src/db/seed.ts",
    "db:reset": "tsx scripts/dbReset.ts",
    "db:migrate": "tsx scripts/migrate.ts up",
    "db:rollback": "tsx scripts/migrate.ts down",
    "start": "node ./scripts/checkNodeVersion.js && tsx backend/src/server.ts",
    "check:runtime": "node ./scripts/checkNodeVersion.js",
    "docker:build": "docker build -t projectxray-ai:latest .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "test": "npm run test:backend && npm run test:frontend && npm run test:llm && npm run test:load",
    "test:frontend": "vitest run",
    "test:watch": "vitest",
    "test:backend": "tsx --test --test-concurrency=1 backend/src/tests/*.test.ts",
    "test:llm": "tsx --test backend/src/tests/llmProviderContract.test.ts",
    "test:load": "tsx backend/src/tests/loadTestHarness.ts"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "bullmq": "^6.3.9",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "framer-motion": "^13.2.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.41.0",
    "pg": "^8.23.0",
    "rate-limiter-flexible": "^11.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.2"
  }
}
